# Workflow lifecycle messages.
#
# Regenerating the ancestral root is destructive and slow, so it asks for an
# explicit confirmation before any work starts. Everything here is presentation
# only; no rule depends on it.

import sys


onstart:
    if INFERRENCE_RERUN and not config.get("static_inference_confirmed", False):
        print(f"""
        ╔══════════════════════════════════════════════════════════════╗
        ║                 ENTEROVIRUS ROOT INFERENCE                   ║
        ║                                                              ║
        ║  This workflow will infer an ancestral root sequence for     ║
        ║  your enterovirus dataset and overwrite:                     ║
        ║   • {INFERRED_ANCESTOR}                            ║
        ║   • {INFERRED_SEQ_PATH}                   ║
        ║   • {INFERRED_META_PATH}                      ║
        ║                                                              ║
        ║  To confirm, restart with:                                   ║
        ║  snakemake -c 9 all --config static_inference_confirmed=true ║
        ║                                                              ║
        ║  Otherwise, set INFERRENCE_RERUN = False to skip inference.  ║
        ╚══════════════════════════════════════════════════════════════╝
""")
        sys.exit("Root inference needs confirmation; see the message above.")


onsuccess:
    if INFERRENCE_RERUN:
        print(f"""
Ancestral root inference finished. Updated:

  {INFERRED_ANCESTOR}      the inferred ancestral sequence
  {INFERRED_SEQ_PATH}      sequences with the ancestor appended
  {INFERRED_META_PATH}     metadata with the ancestor appended

Two things worth doing now:
  - open inferred-root/results/nwk_tree_outgroup.png and check that the
    outgroup sits at the base of the tree
  - set INFERRENCE_RERUN = False again, so later runs reuse this root
""")
    elif STATIC_ANCESTRAL_INFERRENCE:
        print("\nBuild finished. dataset.zip is ready; the existing ancestral root was reused.\n")
    else:
        print("\nBuild finished. dataset.zip is ready.\n")


onerror:
    print("""
The workflow failed. Scroll up for the first error: Snakemake reports the
failing rule and the log file for it, which is usually more informative than
the summary at the bottom.
""")
